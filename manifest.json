{
  "manifest_version": 3,
  "name": "Step Recorder",
  "version": "1.2.0",
  "description": "Records your clicks, typing and page changes as plain English steps. Export to text or Word.",
  "permissions": ["storage", "scripting", "tabs", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Step Recorder",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "add-section": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start a new section"
    },
    "verify-mode": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Verify something on the page"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
